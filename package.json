{
  "name": "dsh-zmd-theme",
  "version": "0.1.0",
  "private": true,
  "description": "ZMD / Endfield Charge Plus (zmd-style) skin for the DSH web GUI: dark military-olive canvas, single fluorescent accent #d6e452, 1px hairlines, square corners.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
